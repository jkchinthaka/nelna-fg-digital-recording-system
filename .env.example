# Nelna FG Digital Recording System — local foundation environment
# Copy to .env and adjust locally. Never commit .env or real secrets.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-insecure-development-key-not-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=Asia/Colombo
DJANGO_LANGUAGE_CODE=en
ENVIRONMENT_LABEL=local
APP_VERSION=0.2.0
LOG_LEVEL=INFO

POSTGRES_DB=nelna_fg
POSTGRES_USER=nelna_fg
POSTGRES_PASSWORD=nelna_fg_local_only
POSTGRES_HOST=127.0.0.1
# Django / application DB connection port.
# PostgreSQL listens on 5432 inside the container. Host apps against Compose publish
# must use COMPOSE_POSTGRES_HOST_PORT (default 5433), not the container listen port.
POSTGRES_PORT=5433
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
DB_CONN_HEALTH_CHECKS=True

# Compose localhost publish only (never used as the in-container listen port).
COMPOSE_POSTGRES_HOST_PORT=5433
COMPOSE_REDIS_HOST_PORT=6380

REDIS_URL=redis://127.0.0.1:6380/0
REDIS_CACHE_TIMEOUT=300
WEB_PORT=8000

CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
