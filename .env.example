# Nelna FG Digital Recording System ? local foundation environment
# Copy to .env and adjust locally. Never commit .env or real secrets.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-insecure-development-key-not-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_TIME_ZONE=Asia/Colombo
DJANGO_LANGUAGE_CODE=en
ENVIRONMENT_LABEL=local
APP_VERSION=0.2.0
LOG_LEVEL=INFO

POSTGRES_DB=nelna_fg
POSTGRES_USER=nelna_fg
POSTGRES_PASSWORD=nelna_fg_local_only
POSTGRES_HOST=127.0.0.1
# Django / application DB connection port.
# PostgreSQL listens on 5432 inside the container. Host apps against Compose publish
# must use COMPOSE_POSTGRES_HOST_PORT (default 5433), not the container listen port.
POSTGRES_PORT=5433
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
DB_CONN_HEALTH_CHECKS=True

# Compose localhost publish only (never used as the in-container listen port).
COMPOSE_POSTGRES_HOST_PORT=5433
COMPOSE_REDIS_HOST_PORT=6380

REDIS_URL=redis://127.0.0.1:6380/0
REDIS_CACHE_TIMEOUT=300
WEB_PORT=8000

CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# Optional SMTP (Phase 15) ? leave empty for local console/locmem backends.
# Never commit real credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com

# Phase 17 ? Bileeta / ERP (live HTTP blocked until APR-011/APR-012 evidence).
# Do not invent endpoints. Leave LIVE disabled and BASE_URL empty without vendor docs.
BILEETA_LIVE_ENABLED=False
BILEETA_BASE_URL=
BILEETA_HTTP_TIMEOUT_SECONDS=10
BILEETA_VERIFY_TLS=True
# BILEETA_CLIENT_ID=
# BILEETA_CLIENT_SECRET=

# Phase 18 ? optional AI assistance (default OFF; core flows must work without AI).
AI_ASSISTANCE_ENABLED=False
AI_ASSISTANCE_PROVIDER=null
AI_ASSISTANCE_TIMEOUT_SECONDS=15
AI_ASSISTANCE_STORE_PROMPTS=False
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# Phase 03 ? Accounts / Auth lockout (defaults match settings if unset)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_WINDOW=300
AUTH_LOGIN_RATE_LIMIT_MAX=40
AUTH_PASSWORD_CHANGE_REQUIRED_ON_ADMIN_RESET=True

# ---------------------------------------------------------------------------
# MongoDB POC only (DB-02) ? NOT the application default database.
# Default SoR remains PostgreSQL (ADR-002) until APR-020 authorizes otherwise.
# Start local replica set: docker compose -f compose.mongo-poc.yaml up -d
# Never commit real Atlas/user passwords.
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=nelnaPocRs&directConnection=true&retryWrites=true&w=majority
# MONGODB_DATABASE=nelna_fg_mongo_poc

# Phase 19 ? session / security headers (production overrides in production settings)
SESSION_COOKIE_AGE=28800
# CONTENT_SECURITY_POLICY=
# PERMISSIONS_POLICY=
HEALTHCHECK_MONGODB_ENABLED=False
# Phase 22 ? lab positive-release runtime blocking (default OFF; company QA approval required)
LAB_POSITIVE_RELEASE_BLOCKING_APPROVED=False
# Phase 25 ? measurement device calibration enforcement (OFF | WARN | BLOCK; default OFF)
INSTRUMENTS_CALIBRATION_ENFORCEMENT=OFF
INSTRUMENTS_CALIBRATION_OVERRIDE_APPROVED=False

# Phase 26 ? foreign-body FAIL auto-HOLD (default OFF; company HACCP evidence required)
FOREIGN_BODY_AUTO_HOLD_APPROVED=False
# Phase 27 ? sanitation FAIL production-stop (default OFF; company SOP approval required)
SANITATION_FAIL_STOP_PRODUCTION_APPROVED=False
# Phase 28 ? environmental excursion auto-HOLD (default OFF; company policy approval required)
ENVIRONMENTAL_AUTO_HOLD_APPROVED=False
# Phase 30 ? allergen matrix / changeover production-block (default OFF; company policy required)
CHANGEOVER_ALLERGEN_BLOCK_APPROVED=False

